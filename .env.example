# ==========================================
# CONFIGURAÇÕES DO SERVIDOR & PUSHIN PAY
# ==========================================

# Porta onde o servidor vai rodar (padrão 3000)
PORT=3000

# Token da Pushin Pay (Bearer Token)
# Obtenha seu token no painel oficial da Pushin Pay em: Configurações > API / Tokens
# Exemplo: 1|xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PUSHINPAY_TOKEN=seu_token_pushinpay_aqui

# Ambiente: producao (https://api.pushinpay.com.br/api) ou sandbox (https://api-sandbox.pushinpay.com.br/api)
PUSHINPAY_ENVIRONMENT=producao

# (Opcional) URL para receber notificações instantâneas de pagamento (Webhook)
# Exemplo: https://seu-dominio.com/api/webhook
PUSHINPAY_WEBHOOK_URL=
